# Production build settings. Vite inlines these at build time, so changing a
# value requires a rebuild, not a restart. All four are public by design.
#
# The OAuth client ID is public and must be available at build time so the
# production login page can render the Google button.
#   VITE_GOOGLE_CLIENT_ID  - OAuth 2.0 Web application client ID
#   VITE_GOOGLE_BROWSER_MAPS_API_KEY   - the BROWSER Maps key (website-restricted), not the server key
VITE_GOOGLE_CLIENT_ID=659909362391-4rqbuec4k4blnr1k94ukqj4q78cqqe3g.apps.googleusercontent.com
# VITE_GOOGLE_BROWSER_MAPS_API_KEY=your_google_maps_browser_key_here

# Leave these two empty. Empty means "use my own address", which is what makes
# sockets, uploads, and the API work when one service serves both halves.
VITE_SOCKET_URL=
VITE_ASSET_ORIGIN=
