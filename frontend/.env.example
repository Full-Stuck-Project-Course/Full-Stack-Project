# Template only — this file is committed. Never put real keys here.
# Copy it to frontend/.env (gitignored) and fill that in for local development.
# Vite does not read .env.example; it reads .env, .env.local and .env.<mode>.
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_BROWSER_MAPS_API_KEY=your_google_maps_browser_key_here
VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_ASSET_ORIGIN=
DEV_BACKEND_TARGET=http://127.0.0.1:5000
