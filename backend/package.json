{
  "name": "hailnow-backend",
  "version": "1.0.0",
  "description": "HailNow backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/check-branding.js && node scripts/check-single-instance-safety.js && node scripts/check-syntax.js && node scripts/check-loyalty-source.js && node scripts/check-admin-capabilities.js && node scripts/check-ride-history-access.js && node scripts/check-carpool-flow.js && npm run unit",
    "unit": "node --test \"tests/**/*.test.js\"",
    "bootstrap:admin": "node scripts/bootstrap-admin.js",
    "privacy:purge-gps": "node scripts/purge-gps-retention.js",
    "migrate:loyalty-points": "node scripts/migrate-loyalty-points-to-user.js"
  },
  "nodemonConfig": {
    "ignore": [
      "uploads/*",
      "public/*",
      "logs/*",
      "coverage/*"
    ]
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "google-auth-library": "^10.9.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.3.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
