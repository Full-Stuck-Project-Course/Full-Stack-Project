PORT=5000
DB_CONNECTION=mongodb://localhost:27017/hailnow
# Generate a private value per environment. The app rejects placeholder values.
JWT_SECRET=replace-with-random-32-plus-character-secret

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

CLIENT_BASE_URL=http://localhost:3000
RETURN_RESET_TOKEN=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hailnow.app@gmail.com
SMTP_PASS=your_google_app_password_here
MAIL_FROM=HailNow <hailnow.app@gmail.com>

# Multi-instance runtime settings.
# Use a shared Redis when running more than one backend replica.
REDIS_URL=
SOCKET_IO_REDIS_URL=
REQUIRE_SOCKET_IO_REDIS=false
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_MAX_KEYS=10000

# Scheduled jobs are protected by MongoDB leases. Disable this on web replicas
# only when a dedicated worker process is responsible for scheduled jobs.
ENABLE_SCHEDULED_TASKS=true
INSTANCE_ID=

# First admin bootstrap. Run `npm run bootstrap:admin` from backend after setting these.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_FULL_NAME=HailNow Admin
BOOTSTRAP_ADMIN_PHONE=0501234567
BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithStrongPassword1
