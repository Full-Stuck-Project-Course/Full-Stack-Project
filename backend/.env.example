PORT=5000
DB_CONNECTION=mongodb://localhost:27017/hailnow
# Generate a private value per environment. The app rejects placeholder values.
JWT_SECRET=replace-with-random-32-plus-character-secret

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

CLIENT_BASE_URL=http://localhost:3000
RETURN_RESET_TOKEN=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hailnow.app@gmail.com
SMTP_PASS=your_google_app_password_here
MAIL_FROM=HailNow <hailnow.app@gmail.com>
